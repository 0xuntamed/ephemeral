LISTEN_ADDRESS=:8080
DATABASE_URL=postgres://ephemeral:ephemeral@postgres:5432/ephemeral?sslmode=disable
# Optional shared application database used to create/drop per-preview schemas.
PREVIEW_DATABASE_URL=
# Bearer token for the API. Required with PROVIDER=terraform: the API refuses to start without it.
EPHEMERAL_API_KEY=

PROVIDER=demo
PREVIEW_DOMAIN=preview.localhost
DEFAULT_IMAGE=demo-service:latest
DEFAULT_TTL=6h
MAX_TTL=24h
MAX_ENVIRONMENTS_PER_USER=3
MAX_ENVIRONMENTS_PER_REPO=10
MAX_CPU=2048
MAX_MEMORY=4096

RUN_WORKER=true
WORKER_INTERVAL=2s
WORKER_CONCURRENCY=4
OPERATION_TIMEOUT=20m
DEMO_STAGE_DELAY=600ms
DEMO_PREVIEW_BASE_URL=http://localhost:8080/preview

# Required only with PROVIDER=terraform.
TERRAFORM_BINARY=terraform
TERRAFORM_DIR=terraform/live
TERRAFORM_DATA_DIR=terraform/runtime-data
TERRAFORM_BACKEND_CONFIG=terraform/live/backend.hcl
TF_VAR_aws_region=us-east-1
TF_VAR_vpc_id=
TF_VAR_subnet_ids=[]
TF_VAR_ecs_cluster_arn=
TF_VAR_https_listener_arn=
TF_VAR_task_execution_role_arn=
TF_VAR_task_role_arn=
TF_VAR_service_security_group_id=
TF_VAR_assign_public_ip=true
TF_VAR_database_host=
TF_VAR_database_name=preview
TF_VAR_database_user=platform
TF_VAR_database_password_secret_arn=
